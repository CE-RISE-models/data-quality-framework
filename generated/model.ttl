<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationLevelEnum#product> a owl:Class ;
    rdfs:label "product" ;
    rdfs:subClassOf dqf:AggregationLevelEnum ;
    skos:definition "Product-level aggregation" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationLevelEnum#record> a owl:Class ;
    rdfs:label "record" ;
    rdfs:subClassOf dqf:AggregationLevelEnum ;
    skos:definition "Record, object, or passport entry" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationLevelEnum#value> a owl:Class ;
    rdfs:label "value" ;
    rdfs:subClassOf dqf:AggregationLevelEnum ;
    skos:definition "Single value or field" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#arithmetic_mean> a owl:Class ;
    rdfs:label "arithmetic_mean" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
    skos:definition "Arithmetic mean" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#custom> a owl:Class ;
    rdfs:label "custom" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
