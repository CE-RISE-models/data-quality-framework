<https://ce-rise-models.codeberg.page/data-quality-framework/ConfidenceLevelEnum#not_evaluated> a owl:Class ;
    rdfs:label "not_evaluated" ;
    rdfs:subClassOf dqf:ConfidenceLevelEnum ;
