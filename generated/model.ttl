<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationLevelEnum#input_quantity> a owl:Class ;
    rdfs:label "input_quantity" ;
    rdfs:subClassOf dqf:AggregationLevelEnum ;
    skos:definition "Input quantity or parameter" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationLevelEnum#material> a owl:Class ;
    rdfs:label "material" ;
    rdfs:subClassOf dqf:AggregationLevelEnum ;
