<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#maximum_risk> a owl:Class ;
    rdfs:label "maximum_risk" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
    skos:definition "Maximum risk or most severe issue determines the aggregate" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#not_evaluated> a owl:Class ;
    rdfs:label "not_evaluated" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
    skos:definition "Aggregation method has not been evaluated" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#rule_based> a owl:Class ;
    rdfs:label "rule_based" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
    skos:definition "Rule-based aggregation, such as green/orange/red decision rules" .

<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#weighted_mean> a owl:Class ;
    rdfs:label "weighted_mean" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
