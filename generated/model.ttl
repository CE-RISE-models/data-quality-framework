<https://ce-rise-models.codeberg.page/data-quality-framework/AggregationMethodEnum#worst_score> a owl:Class ;
    rdfs:label "worst_score" ;
    rdfs:subClassOf dqf:AggregationMethodEnum ;
    skos:definition "Overall score is determined by the worst criterion or limiting factor" .

