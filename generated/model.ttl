dqf:DataQualityAssessment a owl:Class ;
    rdfs:label "DataQualityAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dqf:data_quality_applies_to_class_value ],
