    rdfs:range dqf:QualityCriterionEnum ;
    skos:definition "Quality criterion being assessed" ;
    skos:inScheme dqf: ;
    dqf:owl.filler "dqv:Dimension" ;
    dqf:sql_identifier "dqf_criterion_type" .

dqf:criterion_weight_value a owl:DatatypeProperty ;
